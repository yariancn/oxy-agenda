# Supabase — Guadalajara (MXN)
# URL pública (legacy; ya no se usa en el navegador tras RLS)
NEXT_PUBLIC_SUPABASE_GDL_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_GDL_ANON_KEY=your-anon-key

# Supabase — Shenandoah (USD)
NEXT_PUBLIC_SUPABASE_TX_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_TX_ANON_KEY=your-anon-key

# Server-only (Vercel Production) — OBLIGATORIO tras activar RLS
SUPABASE_GDL_URL=https://your-gdl-project.supabase.co
SUPABASE_GDL_SERVICE_ROLE_KEY=your-gdl-service-role-key
SUPABASE_TX_URL=https://your-tx-project.supabase.co
SUPABASE_TX_SERVICE_ROLE_KEY=your-tx-service-role-key

# Sesión staff (cookie firmada). Genera uno aleatorio largo.
STAFF_SESSION_SECRET=change-me-to-a-long-random-string
# Opcional: PIN supremo solo en servidor (default interno si no se define)
STAFF_SUPREME_PIN=1234567890

# Notificaciones al agendar (Vercel → Settings → Environment Variables)
# Una sola cuenta Resend (p. ej. predictacore) con ambos dominios verificados
RESEND_API_KEY=
RESEND_FROM_GDL=Citas OxyGDL <citas@oxygengdl.com>
RESEND_FROM_TX=OxyHyperbaric <inf@oxyhyperbaric.com>

# USA (Shenandoah): SMS vía Twilio + A2P 10DLC
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+19362825494
# Messaging Service vinculado a la campaña A2P (MG...)
TWILIO_MESSAGING_SERVICE_SID=

# México (Guadalajara): WhatsApp Cloud API (Meta Business)
# Crear app en developers.facebook.com → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Plantillas aprobadas en Meta (categoría Utilidad, idioma es_MX)
WHATSAPP_TEMPLATE_FIRST=programacion
WHATSAPP_TEMPLATE_BOOKING=programacion
WHATSAPP_TEMPLATE_RESCHEDULE=reprogramacion
WHATSAPP_TEMPLATE_CANCEL=cancelacion
WHATSAPP_TEMPLATE_STAFF=oxy_staff_nueva_cita
