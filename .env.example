# Supabase — Guadalajara (MXN)
NEXT_PUBLIC_SUPABASE_GDL_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_GDL_ANON_KEY=your-anon-key

# Supabase — Shenandoah (USD)
NEXT_PUBLIC_SUPABASE_TX_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_TX_ANON_KEY=your-anon-key

# Notificaciones al agendar (Vercel → Settings → Environment Variables)
# Una sola cuenta Resend (p. ej. predictacore) con ambos dominios verificados
RESEND_API_KEY=
RESEND_FROM_GDL=Citas OxyGDL <citas@oxygengdl.com>
RESEND_FROM_TX=OxyHyperbaric <inf@oxyhyperbaric.com>

# USA (Shenandoah): SMS vía Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# México (Guadalajara): WhatsApp Cloud API (Meta Business)
# Crear app en developers.facebook.com → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Plantillas aprobadas en Meta (categoría Utilidad, idioma es_MX)
WHATSAPP_TEMPLATE_FIRST=oxy_cita_confirmada
WHATSAPP_TEMPLATE_BOOKING=oxy_cita_confirmada
WHATSAPP_TEMPLATE_RESCHEDULE=oxy_cita_reprogramada
WHATSAPP_TEMPLATE_CANCEL=oxy_cita_cancelada
WHATSAPP_TEMPLATE_STAFF=oxy_staff_nueva_cita
