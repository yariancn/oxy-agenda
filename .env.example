# Supabase — Guadalajara (MXN)
# Reference ID: yspysvrktdbyvduewlro  (el nombre en el dashboard de Supabase puede ser otro)
NEXT_PUBLIC_SUPABASE_GDL_URL=https://yspysvrktdbyvduewlro.supabase.co
NEXT_PUBLIC_SUPABASE_GDL_ANON_KEY=your-gdl-publishable-or-anon-key

# Supabase — Shenandoah / Texas (USD)
# Reference ID: dbvaoyunpumxokjfwukc  (el nombre en el dashboard de Supabase puede ser otro)
NEXT_PUBLIC_SUPABASE_TX_URL=https://dbvaoyunpumxokjfwukc.supabase.co
NEXT_PUBLIC_SUPABASE_TX_ANON_KEY=your-tx-publishable-or-anon-key

# Server-only (Vercel Production) — OBLIGATORIO tras activar RLS
# Regla: URL y service_role deben ser del MISMO Reference ID (Settings → General en Supabase)
SUPABASE_GDL_URL=https://yspysvrktdbyvduewlro.supabase.co
SUPABASE_GDL_SERVICE_ROLE_KEY=service_role-o-sb_secret-de-yspysvrktdbyvduewlro
SUPABASE_TX_URL=https://dbvaoyunpumxokjfwukc.supabase.co
SUPABASE_TX_SERVICE_ROLE_KEY=service_role-o-sb_secret-de-dbvaoyunpumxokjfwukc

# Sesión staff (cookie firmada). Genera uno aleatorio largo.
STAFF_SESSION_SECRET=change-me-to-a-long-random-string
# Opcional: PIN supremo solo en servidor (default interno si no se define)
STAFF_SUPREME_PIN=1234567890
# Solo este correo (además del admin supremo) ve el panel de ocupación demo en Admin
STAFF_DEMO_OWNER_EMAIL=

# Notificaciones al agendar (Vercel → Settings → Environment Variables)
# Una sola cuenta Resend (p. ej. predictacore) con ambos dominios verificados
RESEND_API_KEY=
RESEND_FROM_GDL=OXYGENGDL <programaciones@oxygengdl.com>
RESEND_FROM_TX=OxyHyperbaric <inf@oxyhyperbaric.com>

# USA (Shenandoah): SMS vía Twilio + A2P 10DLC
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+19362825494
# Messaging Service vinculado a la campaña A2P (MG...)
TWILIO_MESSAGING_SERVICE_SID=

# México (Guadalajara): SMS — LabsMobile (websms.labsmobile.com)
# Mi cuenta → generar token API. Usuario = email o usuario del panel.
LABSMOBILE_USERNAME=
LABSMOBILE_API_TOKEN=
# LABSMOBILE_SENDER=OXYGENDL
# LABSMOBILE_TEST=1
# SMS_MX_PROVIDER=labsmobile
# Alerta saldo bajo (cron diario): SMS al dueño si créditos <= umbral
# LABSMOBILE_LOW_BALANCE_THRESHOLD=100
# LABSMOBILE_ALERT_PHONE=3328332686
# CRON_SECRET=genera-un-secreto-largo

# Alternativas SMS MX (solo si no usas LabsMobile):
# SMS_MASIVOS_API_KEY=
# SMS_402T_USERNAME= / SMS_402T_API_TOKEN= / SMS_402T_API_URL=

# México (Guadalajara): WhatsApp Cloud API — fallback si no hay SMS configurado
# App: Oxygengdl mensajes (1664079171536415) — NO usar token de Predictacore Ads (Marketing API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Coexistencia: /setup/whatsapp — Configuration ID de Facebook Login for Business (Embedded Signup + coexistence)
NEXT_PUBLIC_META_APP_ID=1664079171536415
NEXT_PUBLIC_WHATSAPP_EMBEDDED_CONFIG_ID=
NEXT_PUBLIC_META_GRAPH_VERSION=v21.0
# Plantillas aprobadas en Meta (categoría Utilidad, idioma es_MX)
WHATSAPP_TEMPLATE_FIRST=programacion
WHATSAPP_TEMPLATE_BOOKING=programacion
WHATSAPP_TEMPLATE_RESCHEDULE=reprogramacion
WHATSAPP_TEMPLATE_CANCEL=cancelacion
WHATSAPP_TEMPLATE_STAFF=oxy_staff_nueva_cita
