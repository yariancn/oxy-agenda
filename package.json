{
  "name": "oxy-agenda",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "health-check": "node --env-file=.env.local scripts/health-check.mjs",
    "health-check:db": "node --env-file=.env.local scripts/health-check.mjs --skip-http",
    "seed-demo:gdl": "node --env-file=.env.local scripts/seed-demo-appointments-gdl.mjs",
    "seed-demo:gdl:dry": "node --env-file=.env.local scripts/seed-demo-appointments-gdl.mjs --dry-run",
    "seed-demo:gdl:clear": "node --env-file=.env.local scripts/seed-demo-appointments-gdl.mjs --clear",
    "seed-demo:gdl:next": "node --env-file=.env.local scripts/seed-demo-appointments-gdl.mjs --week=next",
    "seed-demo:gdl:next:dry": "node --env-file=.env.local scripts/seed-demo-appointments-gdl.mjs --week=next --dry-run",
    "seed-demo:gdl:both": "node --env-file=.env.local scripts/seed-demo-appointments-gdl.mjs --both",
    "import-setmore:gdl": "node --env-file=.env.local scripts/import-setmore-gdl.mjs",
    "import-setmore:gdl:dry": "node --env-file=.env.local scripts/import-setmore-gdl.mjs --dry-run",
    "import-setmore:gdl:wipe": "node --env-file=.env.local scripts/import-setmore-gdl.mjs --confirm-wipe",
    "import-setmore:gdl:no-clear": "node --env-file=.env.local scripts/import-setmore-gdl.mjs",
    "import-setmore:customers:gdl": "node --env-file=.env.local scripts/import-setmore-customers-gdl.mjs",
    "import-setmore:customers:gdl:dry": "node --env-file=.env.local scripts/import-setmore-customers-gdl.mjs --dry-run",
    "backup:gdl": "node --env-file=.env.local scripts/backup-gdl.mjs",
    "simulate": "node scripts/simulate-user-flows.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.1",
    "next": "16.2.4",
    "pdfkit": "^0.19.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4"
  }
}
